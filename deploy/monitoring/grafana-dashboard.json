    {
      "type": "row",
      "title": "Threat telemetry (denied-traffic sensor)",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Journal lines /s",
      "description": "",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(fleetguard_agent_sensor_lines_total{instance=~\"$instance\"}[5m]))",
