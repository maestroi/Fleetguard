    },
    {
      "type": "timeseries",
      "title": "Policy age",
      "description": "Time since the current signed revision was accepted.",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - fleetguard_agent_policy_accepted_timestamp_seconds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
