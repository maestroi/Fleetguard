# Choose a published Fleetguard version from GitHub Releases.
# This MUST be set; Compose intentionally does not silently track latest.
FLEETGUARD_TAG=REPLACE_WITH_RELEASE_TAG

# The sample server config listens on this private container address.
# If changing it, update private/server.json too.
FLEETGUARD_SUBNET=172.30.240.0/24
FLEETGUARD_CONTAINER_IP=172.30.240.10
FLEETGUARD_HOST_PORT=9443
