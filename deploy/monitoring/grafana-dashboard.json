      "type": "timeseries",
      "title": "Reports emitted & active sources",
      "description": "",
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fleetguard_agent_sensor_reports_emitted_total{instance=~\"$instance\"}[5m]))",
