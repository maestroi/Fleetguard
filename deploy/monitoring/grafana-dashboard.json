        },
        {
          "refId": "B",
          "expr": "sum(fleetguard_agent_sensor_active_sources{instance=~\"$instance\"})",
          "legendFormat": "active sources",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
