    {
      "type": "timeseries",
      "title": "Desired vs enforced decisions",
      "description": "",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (fleetguard_agent_active_decisions{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} desired",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "fleetguard_agent_enforced_decisions{instance=~\"$instance\"}",
