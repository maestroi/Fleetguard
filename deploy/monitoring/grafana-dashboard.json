        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Policy propagation",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Accepted vs applied revision",
      "description": "",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fleetguard_agent_policy_revision{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} accepted",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "fleetguard_agent_policy_applied_revision{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} applied",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
